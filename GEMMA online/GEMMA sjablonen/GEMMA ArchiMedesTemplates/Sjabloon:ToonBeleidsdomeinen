                    |?Object ID|mainlabel=-|headers=hide|format=plainlist|link=none|limit=500 }} 
              }}<!--
          -->{{#ifeq:{{#var: viewid}}| 
                |{{#var: subgroep}} <!-- (niet gevonden) -->
