   <!--

  Toon relaties van het element
  -->{{#vardefine: previousElementtype|nog geen}}
    <table class="wikitable">  <!-- class="TabelVanApplicatieComponent"> -->
      {{#arraymap:
        {{#ask:
          [[Category:ArchiMateRelationships]]
          [[Has target element::{{#var: pagename}}]]
          OR
          [[Has source element::{{#var: pagename}}]]
          |format=plainlist|headers=hide|link=none|limit=500
          |sort=Elementtype,Has source element,Has target element
          |order=asc,asc,asc
          |limit=10000
        }}|,|__relatie__
        | {{#vardefine: currentElementtype|{{#show:__relatie__|?Elementtype#}} }}
          {{#vardefine: currentDirection| }}
          {{#vardefine: currentDirection
            |{{#ifeq: {{#show:__relatie__|?Has source element#}}| {{#var: pagename}}
              | Uitgaande relaties
              | {{#ifeq: {{#show:__relatie__|?Has target element#}}| {{#var: pagename}}
                | Inkomende relaties
                }}
              }}
          }}<!--
          Toon relatieType bij verandering van het relatieType
            -->
          {{#ifeq: {{#var: currentElementtype}}|{{#var: previousElementtype}}
              ||
              <tr>
                <td colspan="3">''{{#var: currentElementtype}}''</td>
              </tr>
              {{#vardefine: previousElementtype| {{#var: currentElementtype}} }}
              {{#vardefine: previousDirection|nog geen}}
          }}
          {{#if: {{#var: currentDirection}} 
            | <!--
            Toon direction bij verandering van de richting van de relatie--> 
            {{#ifeq: {{#var: currentDirection}}|{{#var: previousDirection}}
                ||<tr>
                  <td>&nbsp;&nbsp;&nbsp;</td>
                  <td colspan="2">''{{#var: currentDirection}}''</td>
                </tr>
                {{#vardefine: previousDirection| {{#var: currentDirection}} }}
            }}
            <tr>
              <td>&nbsp;&nbsp;&nbsp;</td>
              <td>&nbsp;&nbsp;&nbsp;</td>
            {{#ifeq: {{#var: currentDirection}}|Uitgaande relaties|
                |<td>* source = {{#show:__relatie__|?Has source element#}}</td>
                |<td>* target = {{#show:__relatie__|?Has target element#}}</td>
            }}
            </tr>
          }}
            <!-- ** {{FormatRelationshipName|__relatie__|[[{{#show:__relatie__|?Has source element#}}]]
              |[[{{#var: pagename}}]]
              |{{#show:__relatie__|?Elementtype#}} 
            }} -->
            |<nowiki />
      }}
