<!--TS:20211010212752--><noinclude>
[[Categorie:GEMMA ArchiMedesTemplates]]
Wordt gebruikt door [[sjabloon:ToonTabelVanViewGEMMA]]

</noinclude><includeonly>
<!--
   {{#sub:string|start|length}}

-->{{#vardefine: type|
      {{#sub:{{{#userparam| }}}
        | <!-- start --> 
        |{{#pos:{{{#userparam| }}}|__sep1__}} 
      }}
   }}<!--
-->{{#vardefine: filterCount
      |{{#sub:{{{#userparam| }}}
        |{{#expr:{{#pos:{{{#userparam| }}}|__sep1__}} + 8}} 
        |{{#expr:{{#pos:{{{#userparam| }}}|__sep2__}} - {{#expr:{{#pos:{{{#userparam| }}}|__sep1__}} + 8 }} }}
      }}
   }}<!--
-->{{#vardefine: attributen
      |{{#sub:{{{#userparam| }}}
        |{{#expr:{{#pos:{{{#userparam| }}}|__sep2__}} + 8  }} 
        |{{#expr:{{#pos:{{{#userparam| }}}|__sep3__}} - {{#expr:{{#pos:{{{#userparam| }}}|__sep2__}} + 8 }} }}  
       }} 
   }}<!--
-->{{#vardefine: relaties
      |{{#sub:{{{#userparam| }}}
        |{{#expr:{{#pos:{{{#userparam| }}}|__sep3__}} + 8  }} 
        |<!-- {{#len:{{{#userparam| }}} }} eind -->  
       }} 
   }}<!--
-->{{#vardefine: label
      |{{#ifeq: {{#show: {{{1| }}}|?label}} | <!-- leeg -->
          |<geen&nbsp;label> 
          |{{#show: {{{1| }}}|?label}}
       }} 
   }}<!--

Printen waarden
* userparam={{{#userparam| }}}
* type={{#var:type}}
* filterCount={{#var:filterCount}}
* attributen={{#var:attributen}}
* relaties als attributen={{#var:relaties}}
--><tr>
  {{#ifeq: {{#var:type}}|Relatie
    |<td>{{#show: {{{1| }}}|?Has source element}}</td>
  }}
  <td> [[{{{1}}} | {{#var: label}}]] </td>
  {{#ifeq: {{#var:type}}|Relatie
    |<td>{{#show: {{{1| }}}|?Has target element}}</td>
  }}
  <td>{{#ifeq: {{{2}}} | <!-- leeg -->
          |<geen> 
          |{{{2}}}
       }}
  </td> <!-- Beschrijving -->
  <!-- {{#ifeq: {{#var:up}}|toelichting
    |<td>{{formatlist|{{#show: {{{1| }}}|?Toelichting}} }}</td>
  }}
  -->{{#ifexpr: {{#var:filterCount}} = 1  <!-- er is gefilterd op elementtype, geen column elementtype tonen -->
      |<!-- doe niets -->
      |<td>{{#show: {{{1| }}}|?Elementtype}}</td>
  }}<!-- 

  Toon attribuutwaarden
  -->{{#ifeq: {{#var:attributen}}| <!-- leeg -->
    |<!-- doe niets -->
    |{{#arraymap: {{#var: attributen}}|,|__attribuut__|<td> {{#show: {{{1| }}}|?__attribuut__}}</td>|<nowiki />}}
  }}<!-- 

  Toon element dat door relatie wordt aangewezen als attribuut
  -->{{#ifeq: {{#var:relaties}}|<!-- leeg -->
    |<!-- doe niets -->
    |{{#vardefine: relatietype|{{#explode: {{#var:relaties}}|#|0}} }}<!--
    --> {{#vardefine: elementtype|{{#explode: {{#var:relaties}}|#|1}} }}<!-- 
    Is het een reverse relatie? 
    -->{{#ifeq: {{#sub:{{#var: relatietype}}|0|1}}|-
          |<!-- haal dan het '-'-teken weg en zet variabele inverse. op 'Ja'
          -->{{#vardefine:relatietype|{{#sub: {{#var:relatietype}}|1|100}} }} <!--
          -->{{#vardefine:inverse|Ja}} 
        }}
   <!--
    Voer nu de query uit afhankelijk van de richting/inverse is 'Ja' of leeg
    -->{{#ifeq: {{#var:inverse}}|Ja
          |<td>{{#ask: [[Elementtype::{{#var:relatietype}}]] 
              [[has target element::{{{1| }}}]]
              [[has source element.Elementtype::{{#var:elementtype}}]]
              |mainlabel=-
              |?has source element
              |headers=hide
          }}</td>
          |<td>{{#ask: [[Elementtype::{{#var:relatietype}}]] 
              [[has source element::{{{1| }}}]] 
              [[has target element.Elementtype::{{#var:elementtype}}]]
              |mainlabel=-
              |?has target element
              |headers=hide
          }}</td>
    }}
  }}
</tr></includeonly>
